<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/green_light"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/azul1"
        android:minHeight="105dp"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgHoja"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:contentDescription="Imagen de la hoja analizada"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_hojatoma"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNombreEnfermedad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Tizón tardío (Gota)"
            android:textColor="#212121"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvConfianza"
            app:layout_constraintStart_toEndOf="@id/imgHoja"
            app:layout_constraintTop_toTopOf="@id/imgHoja" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="184dp"
            android:layout_height="21dp"
            android:layout_marginTop="4dp"
            android:text="15/09/2026 · 10:30 a. m."
            android:textColor="#757575"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvNombreEnfermedad"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/tvNombreEnfermedad"
            app:layout_constraintTop_toBottomOf="@id/tvNombreEnfermedad" />

        <TextView
            android:id="@+id/tvConfianza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="94%"
            android:textColor="@color/green_main"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvNombreEnfermedad" />

        <TextView
            android:id="@+id/btnVerDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Ver detalle →"
            android:textColor="@color/green_main"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvConfianza" />

        <TextView
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="32dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Eliminar"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvConfianza" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>