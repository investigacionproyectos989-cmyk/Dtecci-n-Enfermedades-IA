<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/green_light"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
       >

        <!-- HEADER -->

        <LinearLayout
            android:id="@+id/headerTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- ICONO -->

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_flask"
                android:background="@drawable/bg_icon_green_light_tratamient"
                android:contentDescription="Icono tratamiento"
                app:tint="@color/green_medium" />

            <!-- TEXTOS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloTratamiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tratamiento recomendado"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloTratamiento"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:text="Seleccione un tratamiento de la lista"

                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CHIP -->

            <LinearLayout
                android:id="@+id/chipToggle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"

                android:background="@drawable/bg_chip_toggle_tratamient">

                <TextView
                    android:id="@+id/tvToggleLabel"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Ver más"

                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgChevron"

                    android:layout_width="18dp"
                    android:layout_height="18dp"

                    android:layout_marginStart="4dp"

                    android:src="@drawable/ic_chevron_down"

                    android:contentDescription="Expandir tratamientos"

                    app:tint="@color/text_secondary" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================= -->
        <!-- CONTENIDO -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/expandableTratamiento"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:visibility="gone">

            <!-- ========================= -->
            <!-- HEADER TABLA -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginHorizontal="8dp"

                android:orientation="horizontal"

                android:background="@drawable/bg_header_tratamiento"

                android:paddingVertical="14dp">

                <!-- INGREDIENTE -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="2"

                    android:paddingHorizontal="8dp"

                    android:text="Ingrediente activo"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"/>

                <!-- PRODUCTO -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="2"

                    android:paddingHorizontal="8dp"

                    android:text="Producto común"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"/>

                <!-- DOSIS -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="2"

                    android:gravity="center"

                    android:text="Dosis"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"/>

                <!-- PC -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="P.C."
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"/>

                <!-- PR -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="P.R."
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <!-- ========================= -->
            <!-- RECYCLERVIEW -->
            <!-- ========================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTratamientos"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginHorizontal="8dp"

                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"

                android:paddingBottom="6dp" />

            <!-- ========================= -->
            <!-- FOOTNOTE -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"

                    android:src="@drawable/ic_info"

                    android:contentDescription="Información"

                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="6dp"

                    android:text="P.C.: Periodo de carencia (días) | P.R.: Periodo de reentrada (horas)"

                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>