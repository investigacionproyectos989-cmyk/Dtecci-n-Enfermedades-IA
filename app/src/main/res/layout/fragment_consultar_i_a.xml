<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E9EB"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.view.ConsultarIAFragment">

    <!-- The actual UI content will be within this ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="#1F1F1F"
            android:elevation="4dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="39dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/back_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_robotia"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Consultar"
                    android:textColor="@android:color/white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/toolbar_options"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_hojatomate"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Premium Access Banner -->
        <androidx.cardview.widget.CardView
            android:id="@+id/premium_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_robotwelly"
                    android:contentDescription="@string/premium_bot_icon"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Los usuarios pueden usar el chat inteligente con conexion a internet "
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Chat Content Area -->
        <ScrollView
            android:id="@+id/chat_scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/input_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/premium_banner">

            <LinearLayout
                android:id="@+id/chat_messages_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/write"
                android:paddingHorizontal="16dp"
                >

                <!-- "Usando el modelo Gratis" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Usando el modelo Gratis"
                    android:textColor="#232222"
                    android:textSize="12sp" />

                <!-- Initial Bot Message -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@color/write"
                    android:padding="16dp"
                    android:text="Hola, soy un bot de tomate puedo responder preguntas relacionadas a enfermedades en las hojas de tomate. Por favor, considera mis respuestas como sugerencias que deben ser verificadas antes de seguirlas. ¿Cómo puedo ayudarte hoy?"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <!-- Second Bot Message -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/write"
                    android:padding="16dp"
                    android:text="¿Puedes subir o tamar su foto de la hoja enferma?."
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <!-- You would dynamically add more chat messages here -->

            </LinearLayout>
        </ScrollView>

        <!-- Input Area -->
        <LinearLayout
            android:id="@+id/input_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="#1F1F1F"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/camera_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera"
                app:tint="#9E9E9E"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tu mensaje"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="#9E9E9E"
                android:maxLines="5"
                android:inputType="textCapSentences|textMultiLine"/>

            <ImageView
                android:id="@+id/send_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_enviar"
                app:tint="#4CAF50"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>