<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_progress_confianza.xml
  Usa <scale> en lugar de <clip> para mantener
  las esquinas redondeadas en ambos extremos del fill
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Track gris de fondo -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/progress_track" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Fill verde con gradiente — esquinas siempre redondeadas -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/green_light_fill"
                    android:endColor="@color/green_dark" />
                <corners android:radius="6dp" />
            </shape>
        </scale>
    </item>

</layer-list>
